{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@rheged-studio/tsconfig/node-tooling",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "eslint.config.ts",
    "index.mjs",
    "infrastructure/scripts/**/*.ts",
    "infrastructure/tests/**/*.ts",
    "prettier.config.mjs",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
