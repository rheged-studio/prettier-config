worker-configuration.d.ts

# Vendored agent-skill bundles: installed with `skills add --copy` and
# overwritten on every refresh.
**/.claude/skills/
**/.agents/skills/

# Changelogs: the dated entries are rewritten by the post-merge enricher, and
# a root CHANGELOG.md is generated.
changelog/
CHANGELOG.md
